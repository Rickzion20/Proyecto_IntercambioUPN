<?xml version="1.0" encoding="utf-8"?>
<!--
    HU10 - Publicar material (rediseño).
    Estructura: formulario desplazable + botón "Publicar" fijo abajo.
    Bloques: 1) Foto con vista previa  2) Información  3) Modalidad y entrega.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    tools:context=".publicar_material">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPublicar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnRegresar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/bg_boton_atras"
                android:contentDescription="@string/t_regresar"
                android:onClick="regresar"
                android:scaleType="center"
                android:src="@drawable/ic_atras"
                android:tooltipText="@string/t_regresar" />

            <TextView
                style="@style/Upn.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:text="@string/t_publicar_material" />

            <TextView
                style="@style/Upn.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="start"
                android:text="@string/t_comparte_lo_que_ya_no_usas_con_otros_e" />

            <!-- ============ 1. FOTO ============ -->
            <TextView
                style="@style/Upn.Bloque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/t_foto_del_material" />

            <TextView
                style="@style/Upn.Ayuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/t_una_buena_foto_ayuda_a_que_te_contacte" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVistaPrevia"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/superficie_suave"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/linea"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgVistaPrevia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/t_vista_previa_de_la_foto"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutSinFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_imagen" />

                    <TextView
                        android:id="@+id/txtEstadoFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/t_pega_el_enlace_de_una_imagen_para_ver"
                        android:textColor="@color/texto_terciario"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUrl"
                style="@style/Upn.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/t_enlace_de_la_imagen"
                app:endIconMode="clear_text"
                app:helperText="@string/t_debe_empezar_con_https"
                app:startIconDrawable="@drawable/ic_enlace">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtUrlImagen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ 2. INFORMACIÓN ============ -->
            <TextView
                style="@style/Upn.Bloque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/t_informacion" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/Upn.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/t_nombre_del_material"
                app:counterEnabled="true"
                app:counterMaxLength="80"
                app:placeholderText="@string/t_ej_calculo_de_stewart_8va_edicion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtNombreMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategoria"
                style="@style/Upn.Campo.Lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/t_categoria">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spCategoriaMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescripcion"
                style="@style/Upn.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/t_descripcion"
                app:counterEnabled="true"
                app:counterMaxLength="400"
                app:placeholderText="@string/t_cuenta_como_esta_que_incluye_y_que_te">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtDescripcionMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="400"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ 3. DETALLES ============ -->
            <TextView
                style="@style/Upn.Bloque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/t_modalidad_y_entrega" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/t_como_quieres_compartirlo"
                android:textColor="@color/texto_medio"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/txtErrorTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/t_elige_una_modalidad"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/t_estado_del_material"
                android:textColor="@color/texto_medio"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/txtErrorEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/t_elige_el_estado_del_material"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSede"
                style="@style/Upn.Campo.Lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/t_sede_de_entrega"
                app:helperText="@string/t_donde_puedes_entregarlo">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spSedeMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botón fijo abajo: siempre visible -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/boton_gris" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarPublicacion"
        style="@style/Upn.Boton.Amarillo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:minHeight="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:onClick="publicar_material"
        android:text="@string/t_publicar_material"
        app:cornerRadius="14dp" />

</LinearLayout>
