<?xml version="1.0" encoding="utf-8"?>
<!-- Una burbuja del chat. La alineación (derecha = mío) y el color se ponen desde chat.java -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filaMensaje"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/burbujaMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/txtTextoMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:text="@string/t_mensaje"
            android:textColor="@color/texto"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtHoraMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="12:00"
            android:textColor="@color/texto_secundario"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
