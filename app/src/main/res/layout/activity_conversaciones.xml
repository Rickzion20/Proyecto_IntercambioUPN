<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".conversaciones">

    <ImageButton
        android:id="@+id/btnRegresarConversaciones"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-4dp"
        android:background="@drawable/bg_boton_atras"
        android:contentDescription="@string/t_regresar"
        android:scaleType="center"
        android:src="@drawable/ic_atras"
        android:tooltipText="@string/t_regresar" />

    <TextView
        style="@style/Upn.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/t_mensajes" />

    <TextView
        style="@style/Upn.Subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/t_coordina_las_entregas_con_otros_estudi" />

    <!-- Buscar personas o publicaciones -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/superficie_suave"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <EditText
            android:id="@+id/txtBuscarConversacion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="@string/t_buscar_personas_o_publicaciones"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_terciario"
            android:textSize="15sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Pestañas: Todos / Con acuerdo / Favoritos -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoFiltroChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:checkedButton="@+id/btnFiltroTodos"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroTodos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/t_todos"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroIntercambios"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="@string/t_con_acuerdo"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroFavoritos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/t_favoritos"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            android:textSize="12sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/btnVerHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:text="@string/t_ver_mi_historial_de_acuerdos"
        android:textColor="@color/texto"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/linea" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerConversaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/txtSinConversaciones"
            style="@style/Upn.Mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/t_aun_no_tienes_conversaciones"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
