<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".filtros">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-4dp"
            android:background="@drawable/bg_boton_atras"
            android:contentDescription="@string/t_regresar"
            android:scaleType="center"
            android:src="@drawable/ic_atras"
            android:tooltipText="@string/t_regresar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/t_filtrar_materiales"
            android:textColor="@color/texto"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/t_personaliza_los_resultados_segun_lo_qu"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/txtLabelCategoria"
            android:layout_marginTop="25dp"
            android:text="@string/t_categoria"
            android:textColor="@color/texto"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:layout_marginTop="6dp"
            android:entries="@array/categorias_material"
            android:backgroundTint="@color/linea_campo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/t_modalidad"
            android:textColor="@color/texto"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spTipoIntercambio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:layout_marginTop="6dp"
            android:entries="@array/tipos_intercambio"
            android:backgroundTint="@color/linea_campo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/t_estado_del_material"
            android:textColor="@color/texto"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spEstadoMaterial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:layout_marginTop="6dp"
            android:entries="@array/estados_material"
            android:backgroundTint="@color/linea_campo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/t_sede_universitaria"
            android:textColor="@color/texto"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spSede"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:layout_marginTop="6dp"
            android:entries="@array/sedes_universitarias"
            android:backgroundTint="@color/linea_campo" />

        <Button
            android:id="@+id/btnAplicarFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/amarillo"
            android:text="@string/t_aplicar_filtros"
            android:textColor="@color/negro_fijo"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnLimpiarFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/boton_gris"
            android:text="@string/t_limpiar_filtros"
            android:textColor="@color/texto"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>

