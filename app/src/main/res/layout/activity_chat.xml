<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".chat">

    <ImageButton
        android:id="@+id/btnRegresarChat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-4dp"
        android:background="@drawable/bg_boton_atras"
        android:contentDescription="@string/t_regresar"
        android:scaleType="center"
        android:src="@drawable/ic_atras"
        android:tooltipText="@string/t_regresar" />

    <!-- Con quién hablo y sobre qué material -->
    <TextView
        android:id="@+id/txtChatNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/t_nombre"
        android:textColor="@color/texto"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtChatMaterial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/t_sobre_material"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

    <!-- HU16: registrar la operación o ver su estado -->
    <Button
        android:id="@+id/btnRegistrarOperacion"
        style="@style/Upn.Boton.Amarillo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:minHeight="46dp"
        android:layout_marginTop="10dp"
        android:text="@string/t_registrar_acuerdo"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtEstadoOperacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/amarillo_tenue"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/t_estado_pendiente"
        android:textColor="@color/texto"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/linea" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMensajes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtSinMensajes"
            style="@style/Upn.Mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/t_escribe_el_primer_mensaje_para_coordin" />
    </FrameLayout>

    <!-- Caja para escribir -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/superficie_suave"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/txtMensajeChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/t_escribe_un_mensaje"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_terciario"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            android:minHeight="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/t_enviar"
                android:textAllCaps="false"
                android:textColor="@color/negro_fijo"
                android:textStyle="bold"
                app:backgroundTint="@color/amarillo"
                app:cornerRadius="11dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
