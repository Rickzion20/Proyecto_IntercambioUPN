<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    tools:context=".perfil">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:onClick="regresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-4dp"
            android:background="@drawable/bg_boton_atras"
            android:contentDescription="@string/t_regresar"
            android:scaleType="center"
            android:src="@drawable/ic_atras"
            android:tooltipText="@string/t_regresar" />

        <TextView
            style="@style/Upn.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/t_mi_perfil" />

        <ImageView
            android:id="@+id/imgFotoPerfil"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:contentDescription="@string/t_foto_de_perfil"
            android:scaleType="centerCrop"
            android:src="@drawable/usuario" />

        <TextView
            android:id="@+id/btnCambiarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:minHeight="48dp"
            android:onClick="cambiarFoto"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/t_cambiar_foto"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtNombreCompleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/t_nombre_del_estudiante"
            android:textColor="@color/texto"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCorreoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/t_correo_upn_pe"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/linea" />

        <TextView
            style="@style/Upn.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/t_informacion_personal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/t_nombres_y_apellidos"
            android:textColor="@color/texto_terciario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtNombrePerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/t_nombre_del_estudiante"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/t_carrera_profesional"
            android:textColor="@color/texto_terciario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCarreraPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/t_no_registrada"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/t_ciclo"
            android:textColor="@color/texto_terciario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCicloPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/t_no_registrado"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/t_tipo_de_usuario"
            android:textColor="@color/texto_terciario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtTipoUsuarioPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/t_estudiante_upn"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblCodigoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/t_codigo_de_estudiante"
            android:textColor="@color/texto_terciario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCodigoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/t_no_registrado"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/t_sede"
            android:textColor="@color/texto_terciario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtSedePerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/t_no_registrada"
            android:textColor="@color/texto"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnEditarPerfil"
            style="@style/Upn.Boton.Amarillo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:layout_marginTop="26dp"
            android:onClick="actualizarDatos"
            android:text="@string/t_actualizar_datos" />

        <Button
            android:id="@+id/btnHistorialPerfil"
            style="@style/Upn.Boton.Gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="10dp"
            android:onClick="abrirHistorial"
            android:text="@string/t_historial_de_acuerdos" />

        <Button
            android:id="@+id/btnCambiarContrasenaPerfil"
            style="@style/Upn.Boton.Gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="10dp"
            android:onClick="cambiarcontrasena"
            android:text="@string/t_cambiar_contrasena" />

        <Button
            android:id="@+id/btnConfiguracionPerfil"
            style="@style/Upn.Boton.Gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="10dp"
            android:onClick="abrirAjustes"
            android:text="@string/t_configuracion" />

        <Button
            android:id="@+id/btnPrivacidadPerfil"
            style="@style/Upn.Boton.Gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="10dp"
            android:onClick="abrirPrivacidad"
            android:text="@string/t_privacidad_y_seguridad" />

        <Button
            android:id="@+id/btnCerrarSesionPerfil"
            style="@style/Upn.Boton.Gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:onClick="cerrarsesion"
            android:text="@string/t_cerrar_sesion_2" />

    </LinearLayout>
</ScrollView>
