<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/fondo"
    tools:context=".cerrar_sesion">

    <ImageButton
        android:id="@+id/btnRegresar"
        android:onClick="regresarseccion"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-4dp"
        android:background="@drawable/bg_boton_atras"
        android:contentDescription="@string/t_regresar"
        android:scaleType="center"
        android:src="@drawable/ic_atras"
        android:tooltipText="@string/t_regresar" />


    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="65dp"
        android:gravity="center"
        android:src="@drawable/usuario"
        android:textColor="@color/texto"
        android:textSize="55sp"
        android:contentDescription="@string/t_icono_cerrar_sesion" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:text="@string/t_cerrar_sesion"
        android:textColor="@color/texto"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:text="@string/t_estas_seguro_de_que_deseas_salir_de_tu"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnConfirmarCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:minHeight="55dp"
        android:layout_marginTop="35dp"
        android:backgroundTint="@color/amarillo"
        android:text="@string/t_si_cerrar_sesion"
        android:onClick="cerrarsesiones"
        android:textColor="@color/negro_fijo"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnCancelarCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:minHeight="52dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/boton_gris"
        android:text="@string/t_cancelar"
        android:textColor="@color/texto"
        android:textAllCaps="false"
        android:onClick="regresarseccion" />

</LinearLayout>
