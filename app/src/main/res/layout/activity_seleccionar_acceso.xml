<?xml version="1.0" encoding="utf-8"?>
<!--
    Primera pantalla sin sesión: el usuario elige cómo va a ingresar.
    Cada tarjeta abre el login con sus propias restricciones de correo.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    tools:context=".seleccionar_acceso">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Opciones disponibles antes de iniciar sesión -->
        <LinearLayout
            android:id="@+id/barraOpcionesBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnIdiomaBienvenida"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_boton_atras"
                android:contentDescription="@string/m_idioma_titulo"
                android:scaleType="center"
                android:src="@drawable/ic_idioma"
                android:tooltipText="@string/m_idioma_titulo" />

            <ImageButton
                android:id="@+id/btnAccesibilidadBienvenida"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_boton_atras"
                android:contentDescription="@string/t_accesibilidad"
                android:scaleType="center"
                android:src="@drawable/ic_accesibilidad"
                android:tooltipText="@string/t_accesibilidad" />
        </LinearLayout>

        <ImageView
            android:layout_width="180dp"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/t_logo_de_la_upn"
            android:scaleType="fitCenter"
            android:src="@drawable/logoupn" />

        <TextView
            style="@style/Upn.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/t_bienvenido_a_intercambio_upn_2" />

        <TextView
            style="@style/Upn.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/t_elige_como_quieres_ingresar" />

        <!-- Opción A: estudiante UPN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccesoUpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:clickable="true"
            android:contentDescription="@string/t_soy_estudiante_upn_ingresar_con_correo"
            android:focusable="true"
            app:cardBackgroundColor="@color/amarillo"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="104dp"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circulo_blanco_fijo"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_escuela"
                    app:tint="@color/negro_fijo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_soy_estudiante_upn"
                        android:textColor="@color/negro_fijo"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/t_ingresa_con_tu_correo_institucional_up"
                        android:textColor="#333333"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_siguiente"
                    app:tint="@color/negro_fijo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Opción B: cuenta externa (Gmail) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccesoGmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:contentDescription="@string/t_tengo_una_cuenta_gmail_ingresar_con_go"
            android:focusable="true"
            app:cardBackgroundColor="@color/superficie_suave"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/linea"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="104dp"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circulo_blanco"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_correo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t_tengo_una_cuenta_gmail"
                        android:textColor="@color/texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/t_ingresa_con_google_o_con_tu_correo_gma"
                        android:textColor="@color/texto_medio"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_siguiente" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Upn.Ayuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/t_los_estudiantes_upn_deben_verificar_su" />

    </LinearLayout>
</ScrollView>
