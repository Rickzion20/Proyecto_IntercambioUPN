<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".ayuda_info">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnRegresarAyuda"
            android:onClick="regresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-4dp"
            android:background="@drawable/bg_boton_atras"
            android:contentDescription="@string/t_regresar"
            android:scaleType="center"
            android:src="@drawable/ic_atras"
            android:tooltipText="@string/t_regresar" />

        <ImageView
            android:layout_width="110dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/t_logo_upn"
            android:scaleType="fitCenter"
            android:src="@drawable/logoupn" />

        <TextView
            style="@style/Upn.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/t_ayuda_y_soporte" />

        <!-- Centro de ayuda y contacto -->
        <TextView
            style="@style/Upn.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/t_centro_de_ayuda_y_contacto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/t_como_publico_un_material_entra_a_publi"
            android:textColor="@color/texto_medio"
            android:textSize="14sp" />

        <Button
            style="@style/Upn.Boton.Amarillo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="14dp"
            android:onClick="contactarSoporte"
            android:text="@string/t_contactar_a_soporte" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/linea" />

        <!-- Sostenibilidad -->
        <TextView
            style="@style/Upn.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/t_sostenibilidad" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/t_intercambiar_prestar_o_donar_libros_ap"
            android:textColor="@color/texto_medio"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/linea" />

        <!-- Acerca de -->
        <TextView
            style="@style/Upn.Seccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/t_acerca_de" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/t_intercambio_upn"
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/t_version_1_0"
            android:textColor="@color/texto_medio"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/t_aplicacion_movil_para_el_intercambio_d"
            android:textColor="@color/texto_medio"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
